{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2022", "dom"],
		"module": "commonjs",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"noImplicitOverride": true,
		"noUnusedLocals": true,
		"skipLibCheck": true,
		/* Node globals are deliberately unavailable: everything under src/ must run
		   on Obsidian mobile, i.e. without Node or Electron APIs. */
		"types": []
	},
	"include": ["main.ts", "src/**/*.ts"]
}
